# Copy to .env and adjust as needed. The server reads these from the
# process environment; nothing loads this file automatically, so either
# export the values yourself or run Node with --env-file, for example:
#   node --env-file=.env dist/server/src/index.js

# Port the Express gateway listens on.
PORT=4002

# Optional. When set, every request that changes state (anything except GET,
# HEAD and OPTIONS under /api) must send this value as "Authorization: Bearer
# <key>" or "X-API-Key: <key>". Leave empty to keep writes open.
CACHEMESH_API_KEY=
