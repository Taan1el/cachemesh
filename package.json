{
  "name": "cachemesh",
  "version": "1.0.0",
  "description": "In-memory key-value cache gateway with LRU/LFU eviction and singleflight stampede protection",
  "private": true,
  "type": "module",
  "homepage": "https://taan1el.github.io/cachemesh/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taan1el/cachemesh.git"
  },
  "bugs": {
    "url": "https://github.com/Taan1el/cachemesh/issues"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build:pages": "npm run build:pages --workspace=client",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:server": "npm run lint --workspace=server",
    "lint:client": "npm run lint --workspace=client",
    "bench": "npm run bench --workspace=server"
  },
  "keywords": [
    "cache",
    "lru-cache",
    "lfu-cache",
    "singleflight",
    "cache-stampede",
    "thundering-herd",
    "key-value-store",
    "react19",
    "sqlite-wal"
  ],
  "author": "Taaniel Vananurm",
  "license": "MIT"
}
